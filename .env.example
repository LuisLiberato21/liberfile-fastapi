# Copia este archivo a ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# Cadena de conexión a MongoDB.
# - Para correr todo con Docker Compose, deja este valor (apunta al contenedor "mongo").
# - Para usar MongoDB Atlas, pega aquí tu cadena "mongodb+srv://..." con un usuario/clave NUEVOS.
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=liberfile_db

# Clave secreta usada para firmar las cookies de sesión.
# Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente

# Configuración de correo (opcional). Si se deja vacío, el código de verificación
# se imprime en la consola del servidor en vez de enviarse por correo real.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
